# ForgeFlow ERP — environment variables
# Copy to .env.local and fill in what you need. With no variables at all the app runs in
# local demo mode: embedded PostgreSQL (PGlite) in .data/pglite, seeded on first start,
# and a demo persona picker instead of passwords. Never commit real credentials.

# --- Database -----------------------------------------------------------------
# Leave unset for the embedded demo database. Set to a PostgreSQL connection string
# (e.g. Supabase → Project Settings → Database → Connection string, "Session pooler")
# to use a real database. Run `npm run db:migrate` and `npm run db:seed` against it.
DATABASE_URL=

# Connection pool size per server instance (postgres.js). Keep small on serverless.
DATABASE_POOL_SIZE=5
# Prepared statements: leave false when connecting through a transaction pooler (port 6543).
DATABASE_PREPARE=false
# Apply migrations and seed automatically on first request when DATABASE_URL is set.
# Convenient for a disposable demo database; prefer explicit `npm run db:migrate` otherwise.
AUTO_MIGRATE=false

# Embedded demo database directory (PGlite mode only).
PGLITE_DATA_DIR=.data/pglite
# Faster but less crash-safe PGlite writes (tests / throwaway environments only).
PGLITE_RELAXED_DURABILITY=false

# Allow Settings → Data → Reset (and `npm run db:reset`) to wipe and re-seed a PostgreSQL
# database. Always allowed for the embedded demo database. Never enable on real data.
ALLOW_DEMO_RESET=false

# --- Authentication -------------------------------------------------------------
# "demo"     = persona picker with signed session cookies (default; for demos only)
# "supabase" = Supabase Auth email/password; users are linked to profiles by email
AUTH_MODE=demo

# Secret used to sign demo session cookies. Required for any shared deployment.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Supabase project (AUTH_MODE=supabase). The anon key is public by design; never put the
# service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Tests (optional) -------------------------------------------------------------
# E2E_BASE_URL=http://localhost:3000   # run Playwright against an already-running server
# E2E_SKIP_BUILD=1                      # reuse the existing production build
# E2E_PORT=3100
